---
import Button from '@components/Button.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout
	title="Página no encontrada"
	description="La página que busca no existe o cambió de dirección."
	noindex
>
	<main class="mx-auto max-w-3xl px-4 py-16">
		<article class="markdown-content">
			<h1>Página no encontrada</h1>
			<p class="text-lg text-slate-700">
				La página que busca no existe o cambió de dirección. Puede volver al inicio o
				usar el buscador para encontrar la información que necesita.
			</p>
			<div class="mt-8 grid gap-3 sm:grid-cols-2">
				<Button href="/" text="Volver al inicio" emoji="🏛️" />
				<Button href="/buscador" text="Buscar en el sitio" emoji="🔍" />
			</div>
		</article>
	</main>
</Layout>
