---
import Layout from '@layouts/Layout.astro';
import PagefindUI from '@components/PagefindUI.astro';
---

<Layout title="Buscador">
	<main class="mx-auto max-w-3xl px-4 py-12" data-pagefind-ignore="all">
		<div class="markdown-content">
			<h1>Buscador</h1>
			<p class="mb-8 text-lg text-slate-700">
				Busque en todas las páginas y documentos del sitio: actas, trámites, licitaciones y más.
			</p>

			<div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-8">
				<PagefindUI />
			</div>
		</div>
	</main>
</Layout>
