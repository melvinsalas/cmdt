---
import {
	ArchiveRestoreIcon,
	CheckmarkBadge02Icon,
	BankIcon,
	Building02Icon,
	Call02Icon,
	ChatIcon,
	ClipboardPenIcon,
	ExternalLinkIcon,
	FavouriteIcon,
	FolderOpenIcon,
	Mail01Icon,
	NavigationIcon,
	ThumbsUpIcon,
	Tree01Icon,
	UserCheck01Icon,
	UserIcon,
	ViewIcon,
	YoutubeIcon,
} from '@hugeicons/core-free-icons';
import type { IconSvgObject } from '@hugeicons/core-free-icons/types';
import type { MenuIconName } from '../data/menus';
import HugeIcon from './HugeIcon.astro';

const { href, title, description, icon, external = false } = Astro.props as {
	href: string;
	title: string;
	description?: string;
	icon: MenuIconName;
	external?: boolean;
};

const iconMap = {
	archive: ArchiveRestoreIcon,
	award: CheckmarkBadge02Icon,
	map: NavigationIcon,
	building: Building02Icon,
	user: UserIcon,
	'folder-open': FolderOpenIcon,
	'clipboard-pen': ClipboardPenIcon,
	'tree-deciduous': Tree01Icon,
	'user-round-check': UserCheck01Icon,
	eye: ViewIcon,
	landmark: BankIcon,
	heart: FavouriteIcon,
	'phone-call': Call02Icon,
	mail: Mail01Icon,
	'thumbs-up': ThumbsUpIcon,
	youtube: YoutubeIcon,
	whatsapp: ChatIcon,
} satisfies Record<MenuIconName, IconSvgObject>;

const iconData = iconMap[icon];
const hasDescription = Boolean(description);
---

<a
	class:list={[
		'group flex gap-3 rounded-lg px-3 py-2 text-slate-700 transition hover:bg-slate-100 hover:text-slate-900',
		hasDescription ? 'items-start' : 'items-center',
	]}
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener noreferrer' : undefined}
>
	<span class:list={[
		'flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-700 transition group-hover:bg-slate-200 group-hover:text-slate-900',
		hasDescription ? 'mt-0.5' : 'mt-0',
	]}>
		<HugeIcon icon={iconData} aria-hidden="true" class="h-4.5 w-4.5" />
	</span>

	<span class="min-w-0 flex-1">
		<span class="block text-sm font-semibold leading-5 text-slate-900">{title}</span>
		{description ? <span class="mt-0.5 block text-xs leading-5 text-slate-500">{description}</span> : null}
	</span>

	{external ? (
		<HugeIcon icon={ExternalLinkIcon} aria-hidden="true" class="h-4 w-4 shrink-0 text-slate-400 self-center" />
	) : null}
</a>
