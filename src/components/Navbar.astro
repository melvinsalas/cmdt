---
import MenuItem from "./MenuItem.astro";
import SearchButton from "./SearchButton.astro";
import HugeIcon from "./HugeIcon.astro";
import { desktopMenuIds, isCurrentPath, menus, primaryLinks } from "../data/menus";
import { SITE_NAME } from "../data/site";
import { ArrowDown01Icon, Cancel01Icon, Menu01Icon } from "@hugeicons/core-free-icons";
import logo from "../assets/logo_alt_96x96.png";

const pathname = Astro.url.pathname;
const desktopMenus = menus.filter((menu) => desktopMenuIds.includes(menu.id));
const sectionIsCurrent = (menu: (typeof menus)[number]) =>
	menu.items.some((item) => isCurrentPath(item.href, pathname));
const topLinkClass =
	"inline-flex h-9 items-center rounded-md px-3 text-slate-700 no-underline transition-colors hover:bg-slate-100 hover:text-slate-900";
const currentTopLinkClass = "bg-brand-50 text-brand-800 hover:bg-brand-100 hover:text-brand-900";
const primary = Object.values(primaryLinks);
---

<a
	href="#contenido"
	class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-medium focus:shadow-lg"
>
	Saltar al contenido
</a>

<header class="paper-surface relative z-[60] border-t-4 border-b border-t-gold-400 border-b-slate-200 px-4 py-2.5">
	<nav
		aria-label="Principal"
		class="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 text-sm font-medium text-slate-700"
	>
		<a
			class="inline-flex min-w-0 items-center gap-2 self-center rounded-md py-1 pr-1 text-slate-900 no-underline sm:gap-2.5"
			href="/"
			aria-label={`${SITE_NAME}, página de inicio`}
		>
			<img src={logo.src} alt="" width="40" height="40" class="h-10 w-10 object-contain" />
			<span class="flex flex-col leading-none" aria-hidden="true">
				<span class="whitespace-nowrap text-[0.625rem] font-semibold uppercase tracking-[0.04em] text-slate-600 sm:text-[0.6875rem] sm:tracking-[0.08em] md:hidden lg:block">
					Concejo Municipal del Distrito
				</span>
				<span class="text-[1.375rem] font-extrabold leading-tight tracking-[-0.01em] text-wine-800">Tucurrique</span>
			</span>
		</a>

		<div class="ml-auto flex shrink-0 items-center gap-2 md:hidden">
			<SearchButton />
			<details class="group relative" id="mobile-menu">
				<summary
					aria-label="Abrir menú"
					class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-slate-200 text-slate-700 marker:content-none hover:bg-slate-100 hover:text-slate-900"
				>
					<HugeIcon icon={Menu01Icon} aria-hidden="true" class="h-5 w-5 group-open:hidden" />
					<HugeIcon icon={Cancel01Icon} aria-hidden="true" class="hidden h-5 w-5 group-open:block" />
				</summary>

				<div
					class="paper-surface fixed right-0 top-0 z-[80] h-full w-[min(22rem,calc(100vw-2rem))] overflow-y-auto border-l border-slate-200 px-4 py-3"
					id="mobile-nav-accordion"
				>
					<div class="mb-4 flex items-center justify-between">
						<span class="pl-1 text-sm font-semibold text-slate-700">Menú</span>
						<button
							id="mobile-close-btn"
							type="button"
							class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900"
							aria-label="Cerrar menú"
						>
							<HugeIcon icon={Cancel01Icon} aria-hidden="true" class="h-5 w-5" />
						</button>
					</div>
					<div class="grid grid-cols-2 gap-2">
						{primary.map((link) => {
							const current = isCurrentPath(link.href, pathname);
							return (
								<a
									href={link.href}
									aria-current={current ? "page" : undefined}
									class:list={[
										"rounded-lg border px-3 py-2.5 text-center text-base font-semibold no-underline",
										current
											? "border-brand-200 bg-brand-50 text-brand-800"
											: "border-slate-200 text-slate-800 hover:bg-slate-100",
									]}
								>
									{link.title}
								</a>
							);
						})}
					</div>
					{
						menus.map((menu) => (
							<div class="mt-5">
								<p class="mb-1 px-3 text-xs font-semibold uppercase tracking-wide text-slate-600">
									{menu.title}
								</p>
								{menu.items.map((item) => (
									<MenuItem {...item} current={isCurrentPath(item.href, pathname)} />
								))}
							</div>
						))
					}
				</div>
			</details>
		</div>

		<div class="hidden shrink-0 items-center gap-1 md:flex" id="desktop-nav-menus">
			<a
				href={primaryLinks.actas.href}
				aria-current={isCurrentPath(primaryLinks.actas.href, pathname) ? "page" : undefined}
				class:list={[topLinkClass, isCurrentPath(primaryLinks.actas.href, pathname) && currentTopLinkClass]}
			>
				{primaryLinks.actas.title}
			</a>
			{
				desktopMenus.map((menu) => (
					<details class="group relative">
						<summary
							class:list={[
								topLinkClass,
								"cursor-pointer list-none gap-1 marker:content-none",
								sectionIsCurrent(menu) && currentTopLinkClass,
							]}
						>
							<span>{menu.title}</span>
							<HugeIcon
								icon={ArrowDown01Icon}
								aria-hidden="true"
								class="h-4 w-4 transition-transform group-open:rotate-180"
							/>
						</summary>
						<div class="desktop-submenu animate-surface absolute right-0 top-full z-[70] min-w-80 pt-2">
							<div class="paper-surface-soft rounded-xl border border-slate-200 p-2 shadow-[0_12px_32px_-12px_rgb(15_23_42/0.25)]">
								{menu.items.map((item) => (
									<MenuItem {...item} current={isCurrentPath(item.href, pathname)} />
								))}
							</div>
						</div>
					</details>
				))
			}
			<a
				href={primaryLinks.contacto.href}
				aria-current={isCurrentPath(primaryLinks.contacto.href, pathname) ? "page" : undefined}
				class:list={[topLinkClass, isCurrentPath(primaryLinks.contacto.href, pathname) && currentTopLinkClass]}
			>
				{primaryLinks.contacto.title}
			</a>
			<span class="ml-2"><SearchButton /></span>
		</div>
	</nav>
</header>

<div
	id="mobile-backdrop"
	class="fixed inset-0 z-[50] hidden bg-black/50 md:hidden"
>
</div>

<script>
	const desktopWrapper =
		document.querySelector<HTMLElement>("#desktop-nav-menus");

	const getDirectDetails = (container: HTMLElement) => [
		...container.querySelectorAll<HTMLDetailsElement>(":scope > details"),
	];

	const closeSiblings = (
		items: HTMLDetailsElement[],
		current: HTMLDetailsElement,
	) => {
		items.forEach((item) => {
			if (item !== current) item.open = false;
		});
	};

	// Escape cierra el menú abierto y devuelve el foco a su botón.
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		const openMenu = document.querySelector<HTMLDetailsElement>(
			"#desktop-nav-menus > details[open], #mobile-menu[open]",
		);
		if (!openMenu) return;
		openMenu.open = false;
		openMenu.querySelector("summary")?.focus();
	});

	if (desktopWrapper) {
		const desktopMenus = getDirectDetails(desktopWrapper);
		const closeDesktopMenus = () => {
			desktopMenus.forEach((menu) => (menu.open = false));
		};
		const menuFromTarget = (target: EventTarget | null) =>
			target instanceof Element
				? target.closest<HTMLDetailsElement>("#desktop-nav-menus > details")
				: null;
		const syncDesktopMenus = (target: EventTarget | null) => {
			const activeMenu = menuFromTarget(target);
			desktopMenus.forEach((menu) => (menu.open = menu === activeMenu));
		};

		desktopMenus.forEach((menu) => {
			menu.addEventListener("toggle", () => {
				if (menu.open) closeSiblings(desktopMenus, menu);
			});
		});

		desktopWrapper.addEventListener("mouseover", (event) => {
			syncDesktopMenus(event.target);
		});
		desktopWrapper.addEventListener("focusin", (event) => {
			syncDesktopMenus(event.target);
		});
		desktopWrapper.addEventListener("mouseleave", closeDesktopMenus);
	}

	const mobileMenu =
		document.querySelector<HTMLDetailsElement>("#mobile-menu");
	const backdrop = document.querySelector<HTMLElement>("#mobile-backdrop");
	const closeBtn =
		document.querySelector<HTMLButtonElement>("#mobile-close-btn");

	const closeMobileMenu = () => {
		if (mobileMenu) mobileMenu.open = false;
	};

	if (mobileMenu && backdrop) {
		const mobileBreakpoint = window.matchMedia("(max-width: 767px)");
		const syncMobileMenu = () => {
			const isOpen = mobileMenu.open && mobileBreakpoint.matches;

			backdrop.classList.toggle("hidden", !mobileMenu.open);
			document.body.style.overflow = isOpen ? "hidden" : "";
		};

		mobileMenu.addEventListener("toggle", syncMobileMenu);
		mobileBreakpoint.addEventListener("change", () => {
			if (!mobileBreakpoint.matches) closeMobileMenu();
			syncMobileMenu();
		});
		window.addEventListener("pageshow", syncMobileMenu);
		backdrop.addEventListener("click", closeMobileMenu);
	}

	closeBtn?.addEventListener("click", closeMobileMenu);
</script>

<style>
	@media (min-width: 768px) {
		#desktop-nav-menus:hover > details:not(:hover) > .desktop-submenu,
		#desktop-nav-menus:not(:hover) > details:not(:focus-within) > .desktop-submenu {
			display: none;
		}
	}
</style>
