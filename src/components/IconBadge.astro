---
import { resolveBadges } from '../data/badges';
import HugeIcon from './HugeIcon.astro';

interface Props {
	badges?: string[];
	/** `chip` muestra el texto siempre; `compact` solo el ícono en pantallas grandes. */
	variant?: 'chip' | 'compact';
}

const { badges = [], variant = 'compact' } = Astro.props;
const items = resolveBadges(badges);
---

{items.length > 0 && (
	<span class="inline-flex flex-wrap items-center gap-1.5">
		{items.map(({ icon, label, chip, key }) => (
			<span
				data-badge={key}
				title={label}
				class:list={[
					'relative inline-flex items-center gap-1 rounded-full border text-xs font-medium leading-5',
					chip,
					variant === 'chip' ? 'px-2 py-0.5' : 'px-1.5 py-0.5 sm:border-transparent sm:bg-transparent sm:px-0.5',
				]}
			>
				<HugeIcon icon={icon} aria-hidden="true" class="h-4 w-4 shrink-0" />
				<span class:list={[variant === 'compact' && 'badge-label-compact']}>{label}</span>
			</span>
		))}
	</span>
)}

<style>
	@media (min-width: 40rem) {
		.badge-label-compact {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
		}
	}
</style>
